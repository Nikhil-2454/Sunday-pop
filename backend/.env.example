# Copy to .env and export these (or set them in your host). Never commit real secrets.
PORT=4000
DB_PATH=./data/sunday-pop.db
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=*
# First admin account, created at startup if it does not exist
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Razorpay: dashboard > Settings > API Keys (use TEST keys first). Webhook secret is set when you create the webhook.
PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PENDING_ORDER_MINUTES=30
